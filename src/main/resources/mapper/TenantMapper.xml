<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="io.factorialsystems.msscstore21authorization.repository.TenantRepository">
    <resultMap id="tenantResultMap" type="io.factorialsystems.msscstore21authorization.model.Tenant">
        <id column="id" property="id" jdbcType="VARCHAR" />
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="secret" property="secret" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
        <result column="created_by" property="createdBy" jdbcType="VARCHAR"/>
        <result column="disabled" property="disabled" jdbcType="BOOLEAN"/>
    </resultMap>

    <sql id="column_list">
        id, name, description, secret, created_at, updated_at, created_by, disabled
    </sql>

    <insert id="save" parameterType="io.factorialsystems.msscstore21authorization.model.Tenant">
        insert into tenants(name, description, secret, created_by)
        values( #{name}, #{description}, #{secret}, #{createdBy})
    </insert>

    <update id="update" parameterType="io.factorialsystems.msscstore21authorization.model.Tenant">
        update tenants
        <set>
            <if test="name != null">name=#{name,jdbcType=VARCHAR},</if>
            <if test="description != null">description=#{description,jdbcType=VARCHAR},</if>
            <if test="secret != null">secret=#{secret,jdbcType=VARCHAR},</if>
            <if test="disabled != null">disabled=#{disabled,jdbcType=BOOLEAN},</if>
        </set>
        where id = #{id}
    </update>

    <select id="findById" parameterType="java.lang.String" resultMap="tenantResultMap">
        select
        <include refid="column_list"/>
        from tenants
        where id = #{id}
    </select>

    <select id="findAll" resultMap="tenantResultMap">
        select
        <include refid="column_list"/>
        from tenants
    </select>
</mapper>
